# Copy to .env and fill in. NEVER commit the real .env (it's in .gitignore).
# On Render, add the same keys under Environment.

# --- Required ---
DATABASE_URL=postgresql://user:password@host/dbname
SECRET_KEY=generate-with: python -c "import secrets; print(secrets.token_hex(32))"
FRONTEND_URL=http://localhost:3000
# Optional extra CORS origins, comma-separated (e.g. Vercel preview URLs)
EXTRA_CORS_ORIGINS=

# --- Job search (free key at https://developer.adzuna.com) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# --- Gmail tracking (Google Cloud console → OAuth client, type "Web application") ---
# Authorized redirect URI must be exactly: <FRONTEND_URL>/oauth/gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Fernet keys, NEWEST FIRST. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEYS=

# --- Scheduled sync (must match the GitHub Actions secret) ---
CRON_SECRET=generate-with: python -c "import secrets; print(secrets.token_urlsafe(32))"
OPPORTUNISTIC_SYNC_MINUTES=15
